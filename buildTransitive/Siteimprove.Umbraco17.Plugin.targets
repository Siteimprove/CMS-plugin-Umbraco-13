<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../contentFiles/any/any/App_Plugins/Siteimprove/**/*"
             Link="App_Plugins/Siteimprove/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
  <Target Name="CopySiteimproveDevelopmentAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <SiteimproveAssets Include="$(MSBuildThisFileDirectory)../contentFiles/any/any/App_Plugins/Siteimprove/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SiteimproveAssets)"
          DestinationFiles="@(SiteimproveAssets->'$(MSBuildProjectDirectory)/App_Plugins/Siteimprove/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
